# ZARVON Environment Configuration Example
# Copy to .env and replace placeholder values for staging/production

DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
ZARVON_FIELD_SECRET=replace-with-a-different-32byte-fernet-secret
DJANGO_DEBUG=True
ZARVON_SANDBOX_MODE=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Click, Payme, Paynet & Uzum Bank PSP Credentials (Production)
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_MERCHANT_USER_ID=
# CLICK_SECRET_KEY=
# PAYME_MERCHANT_ID=
# PAYME_CASHBOX_KEY=
# PAYME_SECRET_KEY=
# PAYNET_SERVICE_ID=
# PAYNET_USERNAME=
# PAYNET_PASSWORD=
# PAYNET_ALLOWED_IPS=
# UZUM_SERVICE_ID=
# UZUM_SECRET_KEY=

# External Credit Bureau (KATM), MIB & MyID Biometric API Adapters
# MYID_API_URL=
# MYID_CLIENT_ID=
# MYID_CLIENT_SECRET=
# KATM_API_URL=
# KATM_API_TOKEN=
# MIB_API_URL=
# MIB_API_TOKEN=

# SMS OTP Gateways (Eskiz.uz or PlayMobile for Production)
# ESKIZ_EMAIL=
# ESKIZ_PASSWORD=
# ESKIZ_FROM=4546
# PLAYMOBILE_URL=
# PLAYMOBILE_USERNAME=
# PLAYMOBILE_PASSWORD=

# Optional PostgreSQL connection URL (falls back to local SQLite if omitted)
# DATABASE_URL=postgres://zarvon_user:password@localhost:5432/zarvon_db
